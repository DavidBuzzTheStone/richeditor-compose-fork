+private fun AnnotatedString.replace(oldChar: Char, newChar: Char): AnnotatedString {
+    if (!text.contains(oldChar)) return this
+    return buildAnnotatedString {
+        var lastIndex = 0
+        for (i in text.indices) {
+            if (text[i] == oldChar) {
+                if (i > lastIndex) {
+                    append(this@replace.subSequence(lastIndex, i))
+                }
+                append(newChar.toString())
+                lastIndex = i + 1
+            }
+        }
+        if (lastIndex < text.length) {
+            append(this@replace.subSequence(lastIndex, text.length))
+        }
+    }
+}
